# Copy to .env.local and fill in. Never commit .env.local.

# Claude API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Notion internal integration token — https://www.notion.so/my-integrations
# Share BOTH databases with the integration (Notion page → ... → Connections).
NOTION_TOKEN=ntn_...

# Optional: defaults for the two databases. You can also paste the links in the
# app's Settings page, which stores them in data/notion-mapping.json.
NOTION_TRANSACTIONS_DB_ID=
NOTION_CATEGORIES_DB_ID=
